---
interface Props {
  color?: string;   // CSS variable name, e.g. '--rose'
  rotate?: number;
  class?: string;
}
const { color = '--rose', rotate = -6, class: cls } = Astro.props;
---
<span class:list={['stamp', cls]} style={`--stamp-color: var(${color}); transform: rotate(${rotate}deg)`} aria-hidden="true">
  <span class="stamp-face"><slot /></span>
</span>
