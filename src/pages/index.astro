---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import headshot from '../assets/photos/headshot.jpg';
import { site, folders, marquee, notes, philosophy, about } from '../data/content';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: 'Bhavana Durgam',
      givenName: 'Bhavana',
      familyName: 'Durgam',
      jobTitle: 'Product Manager',
      worksFor: { '@type': 'Organization', name: 'Salmalita Cosmetics' },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Northwestern University' },
        { '@type': 'CollegeOrUniversity', name: 'BMS College of Engineering' },
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
      email: `mailto:${site.email}`,
      url: `${site.url}/`,
      image: `${site.url}/og/headshot.jpg`,
      knowsAbout: ['Product Management', 'Product Marketing', 'Biomedical Engineering', 'Positioning', 'Go-to-Market Strategy', 'Product Launches', 'Creator Partnerships', 'User Research'],
      award: ['Femina Miss India Karnataka 2018', 'Albert H. Rubenstein Memorial Scholarship'],
      sameAs: [site.socials.linkedin, site.socials.instagram],
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: 'Bhavana Durgam', about: { '@id': `${site.url}/#person` } },
  ],
};

const pastel = ['#F4D6E2', '#E3EAA8', '#EAB0C8', '#EFEDC6', '#C9D863', '#F4D6E2'];
---
<Base title="Bhavana Durgam — Product Manager with PMM experience · Chicago" jsonld={jsonld}>
  <!-- ═══ A. About: photo + hello card ═══ -->
  <section class="hero" aria-label="About Bhavana Durgam">
    <div class="wrap">
      <div class="hello">
        <figure class="hello-photo">
          <Image src={headshot} alt="Bhavana Durgam" widths={[320, 640]} sizes="(max-width: 860px) 240px, 300px" loading="eager" fetchpriority="high" />
        </figure>
        <div class="hello-text">
          <h1 class="hello-h">
            <span class="hi">Hello,</span>
            <span class="im">I’m <span class="circled">Bhavana!<svg class="ring" viewBox="0 0 400 130" preserveAspectRatio="none" aria-hidden="true"><path d="M206 14C120 8 30 26 14 62c-14 34 70 56 186 54 112-2 192-24 186-60C380 22 300 6 196 12 150 15 112 22 96 30" pathLength="1" /></svg></span></span>
          </h1>
          <div class="hello-copy">
            {about.map((p) => <p>{p}</p>)}
          </div>
          <p class="meta mono">{site.meta}</p>
          <div class="ctas">
            <a class="btn btn-ink" href="#files" data-sound>Get to know me ↓</a>
            <a class="btn btn-line" href="/contact/" data-sound>Say hi!</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ B. Marquee ═══ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => marquee.map((m) => <span>{m}<b>✦</b></span>))}
    </div>
  </div>

  <!-- ═══ C. The files ═══ -->
  <section class="files" id="files" aria-labelledby="files-h">
    <div class="wrap files-head">
      <h2 class="h2" id="files-h">My <em>life</em> files</h2>
      <p class="files-hint mono">Hover to peek · click to open one up</p>
    </div>
    <div class="wrap stack" data-stack>
      {folders.map((f, i) => (
        <a
          class:list={['file', { last: i === folders.length - 1 }]}
          href={f.href}
          style={`--c: var(${f.color}); --t: var(${f.ink}); --x: ${f.tabX}%; --i: ${i}`}
          data-sound="open"
          transition:name={`folder-${f.id}`}
        >
          <span class="file-tab">{f.title}</span>
          <span class="file-body">
            <span class="peek">
              <span class="peek-l mono">{f.peek}</span>
              <span class="peek-r">{f.teaser} <span aria-hidden="true">→</span></span>
            </span>
            {i === folders.length - 1 && <span class="file-foot mono">Six folders · one life · no password needed</span>}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ D. Things to know ═══ -->
  <section class="notes on-dark" aria-labelledby="notes-h">
    <div class="wrap">
      <p class="kicker">Off the record</p>
      <h2 class="h2" id="notes-h">A few things <em>to know</em> about me…</h2>
    </div>
    <div class="notes-row">
      <ul class="notes-track">
        {[0, 1].map((k) => notes.map((n, i) => (
          <li class="pola" style={`--tone: ${pastel[i % pastel.length]}; --r: ${[-4, 3, -2, 5, -5, 2, -3, 4][i % 8]}deg`} aria-hidden={k === 1 ? 'true' : undefined}>
            <figure class="pola-card">
              <span class="pola-photo">
                {n.photo
                  ? <img src={n.photo} alt={k === 1 ? '' : `Bhavana Durgam: ${n.text}`} width="600" height="600" loading="lazy" decoding="async" />
                  : <span class="pola-ph" aria-hidden="true">{n.icon}</span>}
              </span>
              <figcaption class="pola-cap">{n.text}</figcaption>
            </figure>
          </li>
        )))}
      </ul>
    </div>
  </section>

  <!-- ═══ E. Stripes + scallop quote ═══ -->
  <section class="stripes" aria-label="How I work">
    <div class="quote-wrap reveal">
      <div class="scallop">
        <div class="scallop-in">
          <p class="kicker">{philosophy.by}</p>
          <blockquote>“{philosophy.quote}”</blockquote>
          <p class="sig">Bhavana Durgam</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── About: hello card ───────────────────────── */
  .hero { padding: clamp(24px, 4vw, 48px) 0 clamp(56px, 7vw, 88px); background: var(--rose); }
  .hello {
    display: grid; grid-template-columns: minmax(0, 3.6fr) minmax(0, 8.4fr);
    background: var(--ivory); border: 1.5px solid var(--plum); border-radius: 22px; overflow: hidden;
    box-shadow: 0 30px 60px -34px rgba(45,10,23,.55);
    animation: rise .8s var(--spring) .05s both;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } }
  /* A framed photo at a modest size, sitting in its own column */
  .hello-photo { margin: 0; display: grid; place-items: center; padding: clamp(24px, 3vw, 44px); border-right: 1.5px solid var(--plum); }
  .hello-photo img {
    width: min(100%, 280px); aspect-ratio: 3 / 4; height: auto; object-fit: cover; object-position: 50% 18%;
    border: 1.5px solid var(--plum); border-radius: 2px; box-shadow: 10px 10px 0 var(--rose); transition: transform .5s var(--spring), box-shadow .5s; animation: settle 1.4s var(--smooth) both;
  }
  .hello-photo img:hover { transform: translateY(-4px); box-shadow: 14px 14px 0 var(--lime); }
  @keyframes settle { from { transform: scale(1.08); } }
  .hello-text {
    display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 4vw, 56px) clamp(24px, 5vw, 80px);
    /* soft paper grain like the inspiration card */
    background-image: radial-gradient(rgba(45,10,23,.05) 1px, transparent 1.2px), radial-gradient(rgba(45,10,23,.035) 1px, transparent 1.2px);
    background-size: 5px 5px, 7px 7px; background-position: 0 0, 2px 3px;
  }
  .hello-h { margin: 0; font: 800 clamp(50px, 6.4vw, 96px)/.88 var(--display); letter-spacing: -0.045em; font-stretch: 88%; color: var(--ink); }
  .hello-h > span { display: block; animation: up .7s var(--spring) both; }
  .hello-h .hi { animation-delay: .25s; }
  .hello-h .im { animation-delay: .38s; }
  @keyframes up { from { opacity: 0; transform: translateY(.35em); } }
  .circled { position: relative; display: inline-block; white-space: nowrap; }
  .ring { position: absolute; left: -9%; top: -14%; width: 118%; height: 128%; overflow: visible; pointer-events: none; z-index: -1; }
  .hello-h .im { position: relative; z-index: 0; }
  .ring path {
    fill: none; stroke: var(--lime); stroke-width: 7; stroke-linecap: round; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.6,.05,.3,1) .9s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .hello-copy { display: grid; gap: 1.1em; margin-top: clamp(22px, 3vw, 34px); max-width: 620px; animation: up .7s ease .55s both; }
  .hello-copy p { font: 400 clamp(15.5px, 1.2vw, 17px)/1.55 var(--sans); color: var(--ink); text-align: justify; }
  .meta { margin-top: 26px; font-size: 12px; font-weight: 700; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }

  @media (max-width: 860px) {
    .hello { grid-template-columns: 1fr; min-height: 0; }
    .hello-photo { border-right: 0; border-bottom: 1.5px solid var(--plum); padding: 28px 24px 30px; }
    .hello-photo img { width: min(62%, 220px); }
    .hello-copy p { text-align: left; }
  }

  /* ── Marquee ──────────────────────────────────── */
  .marquee { background: var(--plum); color: var(--ivory); overflow: hidden; padding: 16px 0; }
  .marquee-track { display: flex; width: max-content; animation: marquee 34s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee span { white-space: nowrap; font: italic 400 26px/1 var(--serif); padding-right: 28px; }
  .marquee b { color: var(--lime); font-weight: 400; margin-left: 28px; font-style: normal; font-size: 18px; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ── The files ────────────────────────────────── */
  .files { padding: 88px 0 96px; }
  .files-head { display: grid; gap: 8px; margin-bottom: 30px; }
  .files-hint { font-size: 12px; font-weight: 700; color: var(--muted); }
  .stack { position: relative; padding-top: 60px; }
  .file {
    position: relative; display: block; margin-bottom: -46px; text-decoration: none; color: var(--t);
    translate: 0 60px; opacity: 0;
    transition: translate .7s var(--spring), opacity .5s ease, transform .45s var(--spring), filter .3s;
    transition-delay: calc(var(--i) * 90ms), calc(var(--i) * 90ms), 0s, 0s;
  }
  .stack.dealt .file, :global(.no-js) .file { translate: 0 0; opacity: 1; }
  .file-tab {
    position: absolute; bottom: calc(100% - 1px); left: var(--x); height: 50px; padding: 0 24px;
    display: flex; align-items: center; gap: 12px; background: var(--c); border-radius: 14px 14px 0 0;
    font: 400 22px/1 var(--serif); white-space: nowrap;
  }
  .file-body {
    display: block; box-sizing: border-box; min-height: 150px; padding: 20px 26px 0; background: var(--c); border-radius: 0 10px 0 0;
    background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.04) 0 1px, transparent 1px 3px);
    box-shadow: 0 -6px 14px rgba(0,0,0,.1);
  }
  .file:nth-child(odd) .file-body { border-radius: 10px 0 0 0; }
  .file.last .file-body { min-height: 230px; padding-bottom: 60px; border-radius: 10px 10px 14px 14px; }
  .file.last { margin-bottom: 0; }
  .peek { display: flex; justify-content: space-between; gap: 24px; }
  .peek-l { font-size: 13px; font-weight: 700; clip-path: inset(0 100% 0 0); }
  .peek-r { font: italic 400 20px/1.2 var(--serif); white-space: nowrap; margin-left: auto; opacity: .85; }
  .file-foot { position: absolute; left: 26px; bottom: 26px; font-size: 12px; font-weight: 700; opacity: .75; }
  .file:hover, .file:focus-visible { transform: translateY(-22px); }
  .file:hover .peek, .file:focus-visible .peek { opacity: 1; }
  .file:hover .peek-l, .file:focus-visible .peek-l { animation: type .9s steps(36) forwards; }
  @keyframes type { to { clip-path: inset(0 0 0 0); } }
  .stack.leaving .file:not(.picked) { translate: 0 120vh; opacity: 0; transition: translate .5s var(--smooth), opacity .4s; transition-delay: calc(var(--i) * 40ms); }
  .stack.leaving .file.picked { transform: translateY(-36px); }
  @media (max-width: 640px) {
    .file-tab { left: 0 !important; font-size: 19px; padding: 0 16px; }
    .peek { flex-direction: column; gap: 6px; opacity: 1; }
    .peek-l { clip-path: none; }
    .peek-r { white-space: normal; }
  }

  /* ── Notes band ───────────────────────────────── */
  .notes { background: var(--plum-deep); color: var(--sheet); padding: 80px 0 90px; overflow: hidden; }
  .notes .kicker { color: var(--lime); }
  .notes .h2 em { color: var(--rose); }
  .notes-row { margin-top: 18px; overflow: hidden; padding: 34px 0 40px; }
  .notes-track { display: flex; gap: 26px; width: max-content; padding: 0; list-style: none; animation: marquee 60s linear infinite; }
  .notes-row:hover .notes-track { animation-play-state: paused; }
  .pola { flex: none; }
  .pola-card {
    position: relative; display: block; width: 230px; margin: 0; padding: 12px 12px 0; background: #fff; text-align: left; color: var(--ink);
    transform: rotate(var(--r)); box-shadow: 0 18px 26px -14px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.2);
    transition: transform .45s var(--spring), box-shadow .4s;
  }
  .pola-card:hover { transform: rotate(0) translateY(-8px) scale(1.05); box-shadow: 0 26px 34px -16px rgba(0,0,0,.6); }
  .pola-photo { display: block; aspect-ratio: 1; overflow: hidden; background: var(--tone); }
  .pola-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.92) contrast(1.02); }
  .pola-ph { display: grid; place-items: center; height: 100%; font-size: 54px; color: rgba(45,10,23,.28); }
  .pola-cap {
    display: block; min-height: 74px; padding: 12px 4px 14px;
    font: 400 14px/1.35 var(--mono); color: var(--ink);
  }

  /* ── Stripes + quote ──────────────────────────── */
  .stripes {
    padding: clamp(64px, 9vw, 120px) var(--gutter);
    background: repeating-linear-gradient(90deg, var(--lime) 0 30px, var(--ivory) 30px 60px);
  }
  .quote-wrap { position: relative; max-width: 680px; margin: 0 auto; }
  .scallop { filter: drop-shadow(0 18px 24px rgba(45,10,23,.18)); }
  .scallop-in { text-align: center; display: grid; gap: 16px; }
  blockquote { font: 400 clamp(26px, 3.4vw, 40px)/1.2 var(--serif); }
  .sig { font: 400 48px/1 var(--script); color: var(--plum); }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { reducedMotion } from '../scripts/shared';

  function initHome() {
    const stack = document.querySelector<HTMLElement>('[data-stack]');
    if (!stack) return;
    stack.classList.remove('leaving');
    stack.querySelectorAll('.picked').forEach((p) => p.classList.remove('picked'));

    // Deal the folders in when the stack scrolls into view.
    if (reducedMotion() || !('IntersectionObserver' in window)) stack.classList.add('dealt');
    else {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { stack.classList.add('dealt'); io.disconnect(); }
      }, { threshold: 0.15 });
      io.observe(stack);
    }

    // Mosby-style open: the other files fall away, the picked one rises into its page.
    stack.querySelectorAll<HTMLAnchorElement>('.file').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0 || reducedMotion()) return;
        e.preventDefault();
        a.classList.add('picked');
        stack.classList.add('leaving');
        setTimeout(() => navigate(a.href), 420);
      });
    });
  }
  document.addEventListener('astro:page-load', initHome);
</script>
