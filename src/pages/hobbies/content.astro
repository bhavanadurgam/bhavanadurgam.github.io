---
import Section from '../../layouts/Section.astro';
import { site } from '../../data/content';
// TODO(Bhavana): add a short screen recording of your Instagram as
// public/video/instagram-preview.mp4 (and a poster image), then set hasVideo = true.
const hasVideo = false;
---
<Section id="hobbies" sub="Content" back={{ href: '/hobbies/', label: 'Back to hobbies' }} title="Content Creation — Bhavana Durgam" description="Bhavana Durgam's content creation: a 125K community across Instagram, YouTube and TikTok.">
  <div class="cc-grid">
    <div>
      <p class="kicker">Hobby 04</p>
      <h1 class="title">Making <em>content</em></h1>
      <p class="lede">Since 2018 I've grown a community from 40K to 125K across Instagram, YouTube and TikTok, mostly by treating every post like a small experiment.</p>
      <p class="cc-body">It's my favourite testing ground for hooks, pacing and audience research: the same work I do in product marketing, at a smaller and more personal scale.</p>
      <dl class="cc-stats">
        <div><dt class="mono">Community</dt><dd>125K</dd></div>
        <div><dt class="mono">Platforms</dt><dd>3</dd></div>
        <div><dt class="mono">Creating since</dt><dd>2018</dd></div>
      </dl>
      <a class="btn btn-ink" href={site.socials.instagram} target="_blank" rel="noopener me" data-sound>Follow on Instagram →</a>
    </div>

    <a class="phone" href={site.socials.instagram} target="_blank" rel="noopener me" aria-label={`Open ${site.socials.instagramHandle} on Instagram`} data-sound>
      <span class="notch" aria-hidden="true"></span>
      <span class="screen">
        {hasVideo ? (
          <video muted autoplay loop playsinline poster="/video/instagram-preview.jpg" aria-hidden="true">
            <source src="/video/instagram-preview.mp4" type="video/mp4" />
          </video>
        ) : (
          <span class="ig" aria-hidden="true">
            <span class="ig-head"><span class="ig-av">b</span><span class="ig-handle">{site.socials.instagramHandle}</span></span>
            <span class="ig-grid">{Array.from({ length: 9 }, (_, i) => <span style={`--g: ${['#E9849F', '#CFE0F5', '#F3D35B', '#C8202F', '#3D78BC', '#E8622A', '#5B2A86', '#F7D3DC', '#4A2516'][i]}`}></span>)}</span>
          </span>
        )}
      </span>
    </a>
  </div>
</Section>

<style>
  .cc-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .cc-body { margin-top: 14px; max-width: 520px; }
  .cc-stats { display: flex; gap: 32px; margin: 28px 0; }
  .cc-stats dt { font-size: 11px; font-weight: 700; color: var(--muted); }
  .cc-stats dd { margin: 0; font: 400 44px/1 var(--serif); color: var(--red); }
  .phone {
    position: relative; display: block; width: 280px; aspect-ratio: 9 / 18.5; padding: 12px; border-radius: 44px; background: var(--ink);
    box-shadow: 0 30px 40px -24px rgba(0,0,0,.6); transform: rotate(4deg); transition: transform .5s var(--spring);
  }
  .phone:hover, .phone:focus-visible { transform: rotate(0) translateY(-10px); }
  .notch { position: absolute; top: 20px; left: 50%; width: 80px; height: 22px; margin-left: -40px; border-radius: 20px; background: var(--ink); z-index: 2; }
  .screen { display: block; height: 100%; border-radius: 34px; overflow: hidden; background: #fff; }
  .screen video { width: 100%; height: 100%; object-fit: cover; }
  .ig { display: grid; gap: 14px; padding: 54px 12px 12px; }
  .ig-head { display: flex; align-items: center; gap: 10px; }
  .ig-av { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--pink); color: var(--sheet); font: 400 30px/1 var(--script); outline: 2px solid var(--orange); outline-offset: 2px; }
  .ig-handle { font: 600 14px/1 var(--sans); color: var(--ink); }
  .ig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .ig-grid span { aspect-ratio: 1; background: var(--g); }
  @media (max-width: 960px) { .cc-grid { grid-template-columns: 1fr; justify-items: center; } .cc-grid > div { justify-self: stretch; } }
  @media (max-width: 400px) { .phone { width: 240px; } .cc-stats { gap: 20px; } }
</style>
