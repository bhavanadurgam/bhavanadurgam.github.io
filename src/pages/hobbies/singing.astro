---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../../layouts/Section.astro';
import { music } from '../../data/content';

const art = import.meta.glob<{ default: ImageMetadata }>('../../assets/music/*.jpg', { eager: true });
const cover = (slug: string) => art[`../../assets/music/${slug}.jpg`]!.default;
const now = new Date();
const month = now.toLocaleString('en-US', { month: 'long' });
const swaras = ['Sa', 'Ri', 'Ga', 'Ma', 'Pa', 'Da', 'Ni', 'Ṡa'];
---
<Section id="hobbies" sub="Music" back={{ href: '/hobbies/', label: 'Back to hobbies' }} title="Music — Bhavana Durgam" description="Bhavana Durgam is trained in Carnatic classical music; singing and listening are her therapy. Plus her current top 3 songs.">
  <header class="frame-head">
    <p class="kicker">Hobby · Music</p>
    <h1 class="title">Music is my <em>therapy</em></h1>
  </header>

  <div class="story">
    <div class="story-text">
      {music.story.map((p) => <p>{p}</p>)}
    </div>
    <figure class="quote" aria-label="A note on music">
      <span class="eq" aria-hidden="true">{Array.from({ length: 7 }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
      <blockquote>Some people journal. <em>I sing.</em></blockquote>
      <figcaption class="mono">Trained in Carnatic classical</figcaption>
    </figure>
  </div>

  <div class="swaras" aria-hidden="true">
    <div class="sw-track">{[0, 1, 2].map(() => swaras.map((s) => <span>{s}<b>♪</b></span>))}</div>
  </div>

  <section class="playlist" aria-labelledby="pl-h">
    <div class="pl-top mono"><span>[ {now.getFullYear()} ]</span><span>{month}</span></div>
    <h2 class="pl-h" id="pl-h">on my <em>playlist:</em></h2>
    <p class="pl-hint mono">Hover a song to hear a preview · tap on your phone</p>

    <ol class="songs">
      {music.playlist.map((s, i) => (
        <li class="song reveal" style={`--d: ${i * 90}ms`}>
          <span class="s-no mono">[ {String(i + 1).padStart(2, '0')} ]</span>
          <div class="card" data-song={s.preview}>
            <div class="art-box">
              <span class="disc">
                <Image src={cover(s.slug)} alt={`${s.title} cover art`} width={300} height={300} />
              </span>
              <span class="bars" aria-hidden="true">{Array.from({ length: 5 }, (_, k) => <i style={`--k:${k}`}></i>)}</span>
            </div>
            <div class="meta">
              <div>
                <p class="s-title">{s.title}</p>
                <p class="s-artist mono">{s.artist}</p>
              </div>
              <button class="play" type="button" aria-label={`Play a preview of ${s.title} by ${s.artist}`} aria-pressed="false">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                  <circle cx="18" cy="18" r="16" class="ring" />
                  <circle cx="18" cy="18" r="16" class="prog" pathLength="100" />
                  <path d="M15 12 L25 18 L15 24 Z" class="tri" />
                  <path d="M14 12 V24 M22 12 V24" class="pause" />
                </svg>
              </button>
            </div>
          </div>
          <a class="s-link mono" href={s.url} target="_blank" rel="noopener">Full song on Apple Music ↗</a>
        </li>
      ))}
    </ol>
    <p class="credit mono">Previews courtesy of Apple Music</p>
  </section>
</Section>

<style>
  /* Story */
  .story { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .story-text p { font: 400 clamp(19px, 2vw, 23px)/1.5 var(--serif); max-width: 640px; }
  .story-text p + p { margin-top: 16px; }
  .quote {
    position: relative; margin: 0; padding: 34px 30px 28px; border-radius: 20px; background: var(--plum-deep); color: var(--ivory);
    box-shadow: 8px 8px 0 var(--rose); transform: rotate(1.5deg);
  }
  .quote blockquote { margin: 18px 0 12px; font: 800 clamp(30px, 3.4vw, 46px)/1 var(--display); letter-spacing: -0.035em; }
  .quote blockquote em { font: italic 400 1.1em/1 var(--serif); letter-spacing: -0.01em; color: var(--rose); }
  .quote figcaption { font-size: 11px; font-weight: 700; color: var(--lime); }
  .eq { display: flex; align-items: flex-end; gap: 5px; height: 34px; }
  .eq i { width: 7px; height: 100%; border-radius: 3px; background: var(--lime); transform-origin: bottom; animation: eq 1.1s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -.17s); }
  .eq i:nth-child(even) { background: var(--rose); }
  @keyframes eq { from { transform: scaleY(.2); } to { transform: scaleY(1); } }

  /* Swaras: the Carnatic scale drifting by */
  .swaras { margin: clamp(40px, 6vw, 64px) 0 0; overflow: hidden; border-block: 1.5px dashed var(--line); padding: 14px 0; }
  .sw-track { display: flex; width: max-content; animation: drift 30s linear infinite; }
  .sw-track span { padding-right: 34px; font: italic 400 30px/1 var(--serif); color: var(--plum); white-space: nowrap; }
  .sw-track b { margin-left: 34px; font: 400 16px/1 var(--sans); color: var(--rose); }
  @keyframes drift { to { transform: translateX(-33.333%); } }

  /* Playlist */
  .playlist { margin-top: clamp(48px, 7vw, 80px); }
  .pl-top { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: var(--muted); }
  .pl-h { margin: clamp(28px, 5vw, 56px) 0 6px; font: 800 clamp(44px, 6.4vw, 84px)/.95 var(--display); letter-spacing: -0.05em; font-stretch: 90%; }
  .pl-h em { font: italic 400 1.08em/1 var(--serif); letter-spacing: -0.01em; color: var(--plum); }
  .pl-hint { font-size: 11px; font-weight: 700; color: var(--muted); }
  .songs { list-style: none; padding: 0; margin: 30px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 28px); }
  .song { display: grid; gap: 10px; }
  .s-no { font-size: 12px; font-weight: 700; color: var(--muted); }
  .card { border: 1.5px solid var(--plum); border-radius: 6px; overflow: hidden; background: var(--ivory); cursor: pointer; transition: transform .45s var(--spring), box-shadow .45s; }
  .card:hover, .card.playing { transform: translateY(-6px); box-shadow: 8px 8px 0 var(--lime); }
  .art-box { position: relative; aspect-ratio: 1 / .92; display: grid; place-items: center; background: var(--plum-deep); }
  .disc { display: block; width: 84%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 6px rgba(247,246,215,.08), 0 14px 26px rgba(0,0,0,.4); transition: transform .6s var(--spring); }
  .disc :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .card:hover .disc { transform: scale(1.04); }
  .card.playing .disc { animation: spin 9s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  .bars { position: absolute; right: 12px; bottom: 12px; display: flex; align-items: flex-end; gap: 3px; height: 22px; opacity: 0; transition: opacity .3s; }
  .bars i { width: 4px; height: 100%; border-radius: 2px; background: var(--lime); transform-origin: bottom; transform: scaleY(.3); }
  .card.playing .bars { opacity: 1; }
  .card.playing .bars i { animation: eq .6s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -.13s); }
  .meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: 18px 16px 16px; border-top: 1.5px solid var(--plum); }
  .s-title { font: 700 clamp(19px, 1.8vw, 23px)/1.15 var(--sans); }
  .s-artist { margin-top: 6px; font-size: 11px; font-weight: 700; color: var(--muted); }
  .play { flex: none; width: 38px; height: 38px; color: var(--plum); }
  .play svg { width: 100%; height: 100%; overflow: visible; }
  .play .ring { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .play .prog { fill: none; stroke: var(--lime); stroke-width: 3.2; stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--p, 0) * 100); transform: rotate(-90deg); transform-origin: center; }
  .play .tri { fill: currentColor; } .play .pause { stroke: currentColor; stroke-width: 3; stroke-linecap: round; display: none; }
  .card.playing .tri { display: none; } .card.playing .pause { display: inline; }
  .play:hover { color: var(--ink); }
  .s-link { justify-self: start; font-size: 10.5px; font-weight: 700; color: var(--plum); text-decoration: none; border-bottom: 2px solid var(--lime); padding-bottom: 3px; }
  .s-link:hover { background: var(--lime); }
  .credit { margin-top: 22px; text-align: right; font-size: 10.5px; font-weight: 700; color: var(--muted); }

  @media (max-width: 860px) { .story { grid-template-columns: 1fr; } .quote { max-width: 420px; } }
  @media (max-width: 640px) { .songs { grid-template-columns: 1fr; max-width: 340px; } }
</style>

<script>
  import { toast } from '../../scripts/shared';

  // Hover (or tap) a song to play Apple's 30-second preview; leaving fades it out.
  let stopAll: (() => void) | undefined;

  function initPlaylist() {
    stopAll?.();
    const cards = [...document.querySelectorAll<HTMLElement>('[data-song]')];
    if (!cards.length) return;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let warned = false;

    const players = cards.map((card) => {
      const audio = new Audio();
      audio.preload = 'none';
      audio.src = card.dataset.song!;
      const btn = card.querySelector<HTMLButtonElement>('.play')!;
      const prog = card.querySelector<HTMLElement>('.prog')!;
      let fade = 0;

      const ramp = (to: number, done?: () => void) => {
        cancelAnimationFrame(fade);
        const from = audio.volume, t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 400);
          audio.volume = from + (to - from) * k;
          if (k < 1) fade = requestAnimationFrame(step); else done?.();
        };
        fade = requestAnimationFrame(step);
      };
      const play = () => {
        players.forEach((p) => p !== self && p.stop());
        audio.volume = 0;
        audio.play().then(() => {
          card.classList.add('playing'); btn.setAttribute('aria-pressed', 'true'); ramp(.85);
        }).catch(() => {
          // Browsers block sound until the visitor has clicked the page once.
          if (!warned) { warned = true; toast('Click a song to start the music'); }
        });
      };
      const stop = () => {
        card.classList.remove('playing'); btn.setAttribute('aria-pressed', 'false');
        if (!audio.paused) ramp(0, () => audio.pause());
      };
      audio.addEventListener('timeupdate', () => prog.style.setProperty('--p', String(audio.currentTime / (audio.duration || 30))));
      audio.addEventListener('ended', () => { stop(); audio.currentTime = 0; });

      if (fine) {
        card.addEventListener('pointerenter', play);
        card.addEventListener('pointerleave', stop);
      }
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (card.classList.contains('playing') && (!fine || e.target === btn || btn.contains(e.target as Node))) stop(); else play();
      });
      const self = { stop, audio };
      return self;
    });

    stopAll = () => players.forEach((p) => { p.stop(); p.audio.pause(); });
  }
  document.addEventListener('astro:page-load', initPlaylist);
  document.addEventListener('astro:before-swap', () => { stopAll?.(); stopAll = undefined; });
</script>
