---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../../layouts/Section.astro';
import { painting } from '../../data/content';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/paintings/*.{png,jpg}', { eager: true });
const pic = (name: string) => (files[`../../assets/paintings/${name}.png`] ?? files[`../../assets/paintings/${name}.jpg`])!.default;
// Larger version for the lightbox (webp keeps the cut-out transparent).
const big = async (m: ImageMetadata) => (await getImage({ src: m, width: Math.min(m.width, 1400), format: 'webp' })).src;

const wall = { m: pic(painting.wall.img) };
const wallBig = await big(wall.m);
const works = await Promise.all(painting.works.map(async (w) => ({ ...w, m: pic(w.img), big: await big(pic(w.img)) })));
---
<Section id="hobbies" sub="Painting" back={{ href: '/hobbies/', label: 'Back to hobbies' }} title="Painting — Bhavana Durgam" description="Bhavana Durgam's paintings: painting is how she manages her anxiety, and she hasn't stopped since. Her gallery wall and her favourite canvases.">
  <header class="frame-head">
    <p class="kicker">Hobby · Painting</p>
    <h1 class="title">Where I get <em>lost</em></h1>
  </header>

  <div class="story">
    {painting.story.map((p) => <p>{p}</p>)}
  </div>

  <figure class="wall reveal">
    <figcaption class="label mono">My gallery wall</figcaption>
    <button class="tile" type="button" data-art={wallBig} data-title="My gallery wall" aria-label="Open: my gallery wall">
      <Image src={wall.m} alt="Bhavana Durgam's gallery wall of her own colourful paintings" widths={[700, 1372]} sizes="(max-width: 960px) 92vw, 1000px" />
    </button>
  </figure>

  <h2 class="recent">What I’ve painted <em>recently</em></h2>
  <ul class="grid" aria-label="Recent paintings">
    {works.map((w, i) => (
      <li class="reveal" style={`--d: ${(i % 4) * 70}ms`}>
        <button class="tile art" type="button" data-art={w.big} data-title="" aria-label="Open painting">
          <Image src={w.m} alt="A painting by Bhavana Durgam" widths={[360, 720]} sizes="(max-width: 640px) 44vw, 260px" />
        </button>
      </li>
    ))}
  </ul>

  <div class="modal" id="art-modal" role="dialog" aria-modal="true" aria-labelledby="art-title">
    <div class="modal-card art-card">
      <button class="modal-close" type="button" aria-label="Close">✕</button>
      <img class="art-big" alt="" />
      <p id="art-title" class="art-title mono"></p>
    </div>
  </div>
</Section>

<style>
  .story { max-width: 760px; margin-bottom: clamp(36px, 5vw, 56px); }
  .story p { font: 400 clamp(17px, 1.5vw, 20px)/1.7 var(--sans); color: var(--ink); }
  .story p:first-child { font-size: clamp(19px, 1.8vw, 23px); line-height: 1.55; font-weight: 500; }
  .story p + p { margin-top: 18px; }

  .label { margin-bottom: 12px; font-size: 12px; font-weight: 700; color: var(--plum); }
  .wall { margin: 0; }
  .recent { margin: clamp(48px, 7vw, 80px) 0 22px; font: 800 clamp(28px, 3.4vw, 44px)/1 var(--display); letter-spacing: -0.03em; }
  .recent em { font: italic 400 1.08em/1 var(--serif); letter-spacing: -0.01em; color: var(--plum); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.2vw, 26px); }
  .tile {
    display: block; width: 100%; overflow: hidden; border-radius: 12px; border: 1.5px solid var(--plum);
    background: #fff; transition: transform .5s var(--spring), box-shadow .5s;
  }
  .wall .tile :global(img) { width: 100%; height: auto; display: block; }
  .tile:hover, .tile:focus-visible { transform: translateY(-6px); box-shadow: 8px 8px 0 var(--rose); }
  .grid li:nth-child(even) .tile:hover, .grid li:nth-child(even) .tile:focus-visible { box-shadow: 8px 8px 0 var(--lime); }
  /* every painting sits the same way: centred on an ivory square, face-on, with a soft shadow */
  .tile.art { position: relative; aspect-ratio: 1; background: radial-gradient(circle at 50% 45%, #fff, var(--ivory) 70%); }
  .tile.art :global(img) {
    position: absolute; inset: 12%; width: 76%; height: 76%; object-fit: contain;
    filter: drop-shadow(0 10px 12px rgba(45,10,23,.25)); transition: transform .6s var(--spring);
  }
  .tile.art:hover :global(img), .tile.art:focus-visible :global(img) { transform: scale(1.07) rotate(-1.5deg); }

  .art-card { display: grid; justify-items: center; gap: 14px; max-width: min(900px, 100%); overflow: visible; }
  .art-big { max-width: 100%; max-height: 78vh; width: auto; filter: drop-shadow(0 30px 40px rgba(0,0,0,.45)); }
  .art-title { color: var(--ivory); font-size: 12px; font-weight: 700; }
  #art-modal .modal-close { top: -14px; right: -14px; }

  @media (max-width: 960px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #art-modal .modal-close { top: 6px; right: 6px; }
  }
</style>

<script>
  import { openModal } from '../../scripts/shared';
  function initArt() {
    const m = document.getElementById('art-modal');
    if (!m) return;
    const img = m.querySelector<HTMLImageElement>('.art-big')!;
    document.querySelectorAll<HTMLElement>('[data-art]').forEach((b) => b.addEventListener('click', () => {
      img.src = b.dataset.art!;
      img.alt = b.dataset.title!;
      m.querySelector('#art-title')!.textContent = b.dataset.title!;
      openModal(m);
    }));
  }
  document.addEventListener('astro:page-load', initArt);
</script>
