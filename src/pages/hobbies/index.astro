---
import Section from '../../layouts/Section.astro';
import { hobbies } from '../../data/content';

// Where each object rests on the table: x, y, width (% of the board), tilt, depth (parallax strength).
// m* = phone layout (a taller table with a 2x2 grid).
const spots: Record<string, { x: number; y: number; w: number; r: number; d: number; mx: number; my: number; mw: number }> = {
  Reading:            { x: 7,  y: 9,  w: 21, r: -6, d: 1.0, mx: 6,  my: 37, mw: 40 },
  Painting:           { x: 66, y: 9,  w: 24, r: 5,  d: 1.4, mx: 52, my: 36, mw: 43 },
  Music:              { x: 8,  y: 58, w: 20, r: -4, d: 1.2, mx: 8,  my: 67, mw: 38 },
  'Content creation': { x: 71, y: 61, w: 21, r: -5, d: 0.8, mx: 53, my: 69, mw: 40 },
};
---
<Section id="hobbies" title="Hobbies — Bhavana Durgam" description="Bhavana Durgam off the clock: reading (her bookshelf), painting, music and content creation.">
  <header class="frame-head">
    <p class="kicker">Hobbies</p>
    <p class="lede">I think personality makes a product person better. Here's what I love when I'm off the clock.</p>
  </header>

  <div class="board" data-board>
    <div class="board-center">
      <h1 class="board-title">The hobby <em>archive</em></h1>
      <p class="now mono" aria-hidden="true">
        <span class="n-0"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11m0-1.5a1.5 1.5 0 0 1 3 0V11m0-.5a1.5 1.5 0 0 1 3 0v4.5a6 6 0 0 1-6 6h-1.2a5 5 0 0 1-4-2l-3-4a1.5 1.5 0 0 1 2.3-1.9L9 15V11" /></svg><span class="cta-fine">Click an object to open it</span><span class="cta-touch">Tap an object to open it</span></span>
        {hobbies.map((h) => <span class={`n-${h.no}`}>{h.label} →</span>)}
      </p>
    </div>

    <!-- doodles: a few daisies and sparkles -->
    {[1, 2, 3].map((n) => (
      <svg class={`flower f${n}`} viewBox="0 0 100 100" aria-hidden="true">
        {[0, 60, 120, 180, 240, 300].map((a) => <ellipse cx="50" cy="25" rx="13" ry="21" transform={`rotate(${a} 50 50)`} />)}
        <circle cx="50" cy="50" r="12" class="core" />
      </svg>
    ))}
    {[1, 2, 3, 4, 5, 6, 7].map((n) => (
      <svg class={`spark s${n}`} viewBox="-12 -12 24 24" aria-hidden="true"><path d="M0-11C1-2 2-1 11 0C2 1 1 2 0 11C-1 2-2 1-11 0C-2-1-1-2 0-11Z" /></svg>
    ))}

    {hobbies.map((h, i) => {
      const s = spots[h.title];
      return (
        <a
          class:list={['obj', `obj-${h.no}`]}
          href={h.href}
          style={`--x:${s.x}%; --y:${s.y}%; --w:${s.w}%; --r:${s.r}deg; --d:${s.d}; --mx:${s.mx}%; --my:${s.my}%; --mw:${s.mw}%; --i:${i}`}
          data-sound="open"
          aria-label={`${h.title}: ${h.label}`}
        >
          <span class="par"><span class="bob">
              {h.no === '01' && (
                <svg class="art doodle books" viewBox="0 0 230 200" aria-hidden="true">
                  <g class="b1"><rect x="16" y="152" width="198" height="36" rx="7" class="fill-rose" /><rect x="194" y="158" width="12" height="24" rx="3" class="pg" /><path d="M40 162v16M50 162v16" class="ln" /></g>
                  <g class="b3"><rect x="28" y="116" width="176" height="36" rx="7" class="fill-lime" /><rect x="36" y="122" width="12" height="24" rx="3" class="pg" /><path d="M70 128h84M70 140h54" class="ln" /></g>
                  <g class="b4">
                    <path d="M115 110C92 98 60 98 30 106V44C60 36 92 36 115 50Z" class="pg" />
                    <path d="M115 110C138 98 170 98 200 106V44C170 36 138 36 115 50Z" class="pg" />
                    <path d="M115 50V110" class="ln" />
                    <path d="M44 60C64 54 84 54 102 62M44 74C64 68 84 68 102 76M44 88C64 82 84 82 102 90" class="ln soft" />
                    <path d="M156 78c-5-9-18-5-13 5l13 11 13-11c5-10-8-14-13-5z" class="fill-rose" />
                    <path d="M178 40v34l6-6 6 6V38" class="fill-plum" />
                  </g>
                </svg>
              )}
              {h.no === '02' && (
                <svg class="art doodle palette" viewBox="0 0 260 214" aria-hidden="true">
                  <rect x="36" y="8" width="168" height="80" rx="11" class="fill-rose-soft" /><rect x="48" y="20" width="144" height="56" rx="7" class="fill-rose hl" />
                  <rect x="22" y="86" width="198" height="98" rx="13" class="fill-rose" /><rect x="34" y="98" width="174" height="74" rx="8" class="fill-ivory" />
                  {['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10'].map((c, k) => (
                    <rect x={44 + (k % 5) * 32} y={k < 5 ? 106 : 138} width="26" height="24" rx="6" class={`pan ${c}`} />
                  ))}
                  <g class="brush">
                    <path d="M108 206L238 152" class="h-out" /><path d="M108 206L238 152" class="h-in rose" /><path d="M104 208l-16 5c-7 2-6-3-2-6l12-8z" class="fill-plum" />
                    <path d="M126 196L246 146" class="h-out" /><path d="M126 196L246 146" class="h-in lime" /><path d="M122 198l-15 5c-7 2-6-3-2-6l12-8z" class="fill-lime" />
                  </g>
                </svg>
              )}
              {h.no === '03' && (
                <svg class="art doodle phones" viewBox="0 0 240 224" aria-hidden="true">
                  <path class="band-out" d="M46 132C40 54 84 20 120 20C156 20 200 54 194 132" />
                  <path class="band" d="M46 132C40 54 84 20 120 20C156 20 200 54 194 132" />
                  <path d="M58 72l12 6M182 72l-12 6" class="ln lime-ln" />
                  <g class="cup cup-l"><rect x="20" y="112" width="56" height="88" rx="26" class="fill-rose" /><rect x="58" y="124" width="24" height="64" rx="11" class="fill-lime" /><path d="M34 140c6-6 14-6 18 0M34 158c6-6 14-6 18 0" class="ln soft" /></g>
                  <g class="cup cup-r"><rect x="164" y="112" width="56" height="88" rx="26" class="fill-rose" /><rect x="158" y="124" width="24" height="64" rx="11" class="fill-lime" /><path d="M188 140c6-6 14-6 18 0M188 158c6-6 14-6 18 0" class="ln soft" /></g>
                  <g class="notes"><path d="M104 98V66l24-6v30" /><circle cx="99" cy="99" r="7" /><circle cx="123" cy="91" r="7" /><path d="M146 76V52" /><circle cx="141" cy="78" r="6" /></g>
                </svg>
              )}
              {h.no === '04' && (
                <svg class="art doodle camera" viewBox="0 0 230 176" aria-hidden="true">
                  <rect x="30" y="20" width="58" height="24" rx="8" class="fill-rose" /><rect x="166" y="22" width="36" height="18" rx="6" class="fill-plum" />
                  <rect x="10" y="36" width="210" height="128" rx="24" class="fill-rose-soft" />
                  <rect x="150" y="52" width="54" height="28" rx="7" class="fill-ivory" />
                  <circle cx="104" cy="102" r="46" class="fill-ivory" /><circle cx="104" cy="102" r="34" class="fill-plum" /><circle cx="104" cy="102" r="20" class="fill-lens" />
                  <path d="M92 90a14 14 0 0 1 10-6" class="hl-ln" />
                  <path d="M182 116c-8-12-26-6-18 8l18 16 18-16c8-14-10-20-18-8z" class="fill-lime" />
                  <path d="M40 132l5 10 11 2-8 8 2 11-10-5-10 5 2-11-8-8 11-2z" class="fill-lime" />
                </svg>
              )}
          </span></span>
          <span class="tag mono">{h.title} <span class="go" aria-hidden="true">↗</span></span>
          {h.no === '04' && <span class="flash" aria-hidden="true"></span>}
        </a>
      );
    })}
  </div>
</Section>

<style>
  .frame-head { margin-bottom: 20px; }
  .board {
    --px: 0; --py: 0;
    position: relative; aspect-ratio: 16 / 9.4; border-radius: 18px; overflow: hidden; isolation: isolate;
    background-color: var(--plum-deep);
    background-image: radial-gradient(rgba(247,246,215,.05) 1px, transparent 1.4px), radial-gradient(circle at 50% 48%, rgba(234,176,200,.18), transparent 58%);
    background-size: 6px 6px, 100% 100%;
    box-shadow: inset 0 0 0 1.5px var(--plum), 0 30px 50px -30px rgba(45,10,23,.6);
  }

  /* centre: title + a line that names whatever you're hovering */
  .board-center {
    position: absolute; left: 50%; top: 50%; z-index: 2; text-align: center; pointer-events: none;
    transform: translate(calc(-50% + var(--px) * -6px), calc(-50% + var(--py) * -6px)); transition: transform .6s var(--smooth);
  }
  .board-title {
    margin: 0; font: 800 clamp(36px, 6.4vw, 92px)/.86 var(--display); letter-spacing: -0.045em; font-stretch: 88%; color: var(--ivory);
    animation: rise-in 1s var(--spring) .1s both;
  }
  .board-title em { display: block; font: italic 400 1.1em/1 var(--serif); letter-spacing: -0.01em; color: var(--rose); }
  @keyframes rise-in { from { opacity: 0; transform: translateY(24px) scale(.94); } }
  /* the call to action: a clear pill telling people the objects open */
  .now { position: relative; height: 2.6em; margin-top: 20px; font-size: clamp(11px, .95vw, 13px); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--lime); }
  .now > span { position: absolute; left: 50%; top: 0; translate: -50% 0; white-space: nowrap; transition: opacity .3s, transform .4s var(--spring); }
  .now > span:not(.n-0) { opacity: 0; transform: translateY(8px); line-height: 2.6em; }
  .n-0 { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px 8px 12px; border-radius: 999px; background: var(--lime); color: var(--ink); box-shadow: 0 0 0 0 rgba(201,216,99,.6); animation: beckon 2.2s ease-out infinite; }
  .n-0 svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; animation: tap 2.2s ease-in-out infinite; }
  @keyframes beckon { 0% { box-shadow: 0 0 0 0 rgba(201,216,99,.55); } 70%, 100% { box-shadow: 0 0 0 14px rgba(201,216,99,0); } }
  @keyframes tap { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(3px) scale(.92); } }
  .cta-touch { display: none; }
  @media (hover: none) { .cta-fine { display: none; } .cta-touch { display: inline; } }
  .board:has(.obj:hover, .obj:focus-visible) .n-0 { opacity: 0; transform: translateY(-8px); }
  .board:has(.obj-01:hover, .obj-01:focus-visible) .n-01,
  .board:has(.obj-02:hover, .obj-02:focus-visible) .n-02,
  .board:has(.obj-03:hover, .obj-03:focus-visible) .n-03,
  .board:has(.obj-04:hover, .obj-04:focus-visible) .n-04 { opacity: 1; transform: none; }

  /* objects: placed (a) > parallax (.par) > idle float (.bob) > art */
  .obj {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); z-index: 3; display: block; text-decoration: none;
    transform: rotate(var(--r)); transition: transform .6s var(--spring), opacity .4s, filter .4s;
    animation: place 1s var(--spring) both; animation-delay: calc(.35s + var(--i) * .14s);
  }
  /* each one slides onto the table from its own corner */
  @keyframes place { from { opacity: 0; translate: calc((var(--x) - 40%) * .5) 60px; rotate: calc(var(--r) * -3); } }
  .par { display: block; transform: translate(calc(var(--px) * var(--d) * 14px), calc(var(--py) * var(--d) * 14px)); transition: transform .5s var(--smooth); }
  .bob { display: block; animation: bob 6s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -1.7s); }
  @keyframes bob { from { translate: 0 -5px; rotate: -1deg; } to { translate: 0 6px; rotate: 1.2deg; } }
  .art { display: block; width: 100%; height: auto; overflow: visible; filter: drop-shadow(0 16px 14px rgba(0,0,0,.38)); transition: filter .5s; }

  .obj:hover, .obj:focus-visible { z-index: 6; transform: rotate(0deg) translateY(-12px) scale(1.08); }
  .obj:hover .art, .obj:focus-visible .art { filter: drop-shadow(0 30px 24px rgba(0,0,0,.5)); }
  .obj:hover .bob, .obj:focus-visible .bob { animation-play-state: paused; }
  /* everything else steps back */
  .board:has(.obj:hover, .obj:focus-visible) .obj:not(:hover, :focus-visible) { opacity: .45; filter: saturate(.6) blur(1.5px); transform: rotate(var(--r)) scale(.96); }
  .obj:focus-visible { outline: none; }
  .obj:focus-visible .tag { outline: 2px solid var(--lime); outline-offset: 3px; }

  .tag {
    position: absolute; left: 50%; bottom: -14px; translate: -50% 0; white-space: nowrap; padding: 7px 12px; border-radius: 4px;
    background: var(--ivory); color: var(--ink); font-size: clamp(10px, .9vw, 12px); font-weight: 700; letter-spacing: .1em;
    box-shadow: 0 6px 12px rgba(0,0,0,.25); transform: rotate(calc(var(--r) * -1)); transition: background .25s, transform .45s var(--spring);
  }
  .tag b { color: var(--plum); margin-right: 4px; }
  .obj:hover .tag, .obj:focus-visible .tag { background: var(--lime); transform: rotate(0) translateY(6px); }
  .tag .go { display: inline-block; margin-left: 4px; color: var(--plum); transition: transform .35s var(--spring); }
  .obj:hover .tag .go { transform: translate(2px, -2px); }
  /* until someone picks something up, the labels glow one after another */
  .board:not(.touched) .tag { animation: nudge 4.8s ease-in-out infinite; animation-delay: calc(1.6s + var(--i) * 1.2s); }
  @keyframes nudge { 0%, 18%, 100% { box-shadow: 0 6px 12px rgba(0,0,0,.25), 0 0 0 0 rgba(201,216,99,0); } 8% { box-shadow: 0 6px 12px rgba(0,0,0,.25), 0 0 0 6px rgba(201,216,99,.7); } }

  /* doodle style: dark ink outlines, soft fills, round joins (like a sticker sheet) */
  .doodle :is(rect, path, circle, ellipse) { stroke: var(--ink); stroke-width: 3.2; stroke-linejoin: round; stroke-linecap: round; }
  .doodle .fill-rose { fill: var(--rose); } .doodle .fill-rose-soft { fill: var(--rose-soft); } .doodle .fill-lime { fill: var(--lime); }
  .doodle .fill-ivory, .doodle .pg { fill: #FFFDF2; } .doodle .fill-plum { fill: var(--plum); } .doodle .fill-lens { fill: #8E5A78; }
  .doodle .ln { fill: none; stroke-width: 2.6; } .doodle .ln.soft { stroke: rgba(45,10,23,.45); stroke-width: 2.2; }
  .doodle .hl { stroke-width: 2; } .doodle .hl-ln { fill: none; stroke: #fff; stroke-width: 4; }

  /* books */
  .books .b4, .books .b3 { transition: transform .5s var(--spring); transform-origin: 50% 100%; }
  .obj-01:hover .b4 { transform: translateY(-14px) rotate(-4deg); } .obj-01:hover .b3 { transform: translateX(6px); }

  /* paint tin */
  .palette .pan { stroke-width: 2.4; transition: transform .5s var(--spring); transform-box: fill-box; transform-origin: center; }
  .palette .c1 { fill: var(--plum); } .palette .c2 { fill: var(--rose); } .palette .c3 { fill: var(--lime); } .palette .c4 { fill: #F2A65A; } .palette .c5 { fill: #9FC3E8; }
  .palette .c6 { fill: #C9B8E8; } .palette .c7 { fill: #F4D6E2; } .palette .c8 { fill: #E3EAA8; } .palette .c9 { fill: #E86B86; } .palette .c10 { fill: #FFE08A; }
  .obj-02:hover .pan { transform: scale(1.12); }
  .palette .h-out { fill: none; stroke-width: 10; } .palette .h-in { fill: none; stroke-width: 4.5; } .palette .h-in.rose { stroke: var(--rose); } .palette .h-in.lime { stroke: var(--lime); }
  .palette .brush { transition: transform .6s var(--spring); }
  .obj-02:hover .brush { transform: translate(-10px, 8px) rotate(-5deg); }

  /* headphones */
  .phones .band-out { fill: none; stroke-width: 20; } .phones .band { fill: none; stroke: var(--rose); stroke-width: 13; }
  .phones .lime-ln { stroke: var(--lime); stroke-width: 6; }
  .phones .notes { fill: var(--lime); stroke: var(--lime); stroke-width: 4; opacity: 0; translate: 0 10px; transition: opacity .4s, translate .6s var(--spring); }
  .phones .notes circle { stroke: var(--ink); stroke-width: 2; }
  .phones .cup { transform-box: fill-box; transform-origin: 50% 0; }
  .obj-03:hover .notes, .obj-03:focus-visible .notes { opacity: 1; translate: 0 -14px; }
  .obj-03:hover .cup-l, .obj-03:focus-visible .cup-l { animation: beat .5s ease-in-out infinite alternate; }
  .obj-03:hover .cup-r, .obj-03:focus-visible .cup-r { animation: beat .5s ease-in-out .25s infinite alternate; }
  @keyframes beat { to { scale: 1.06; } }

  /* camera */
  .flash { position: absolute; inset: -30%; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.95), transparent 60%); opacity: 0; pointer-events: none; }
  .obj-04:hover .flash, .obj-04:focus-visible .flash { animation: flash .5s ease-out; }
  @keyframes flash { 0% { opacity: 0; } 20% { opacity: 1; } 100% { opacity: 0; } }

  /* daisies, drifting slowly */
  .flower { position: absolute; z-index: 1; pointer-events: none; transition: opacity .4s; animation: drift 14s ease-in-out infinite alternate; }
  .flower ellipse, .flower circle { stroke: var(--ink); stroke-width: 4; }
  .flower ellipse { fill: #FFFDF2; } .flower .core { fill: var(--lime); }
  .f1 { left: 33%; top: 70%; width: 6%; }
  .f2 { left: 57%; top: 13%; width: 5.5%; animation-delay: -6s; } .f2 ellipse { fill: var(--rose); } .f2 .core { fill: #FFE08A; }
  .f3 { left: 91%; top: 54%; width: 5%; animation-delay: -3s; }
  @keyframes drift { from { rotate: -8deg; translate: 0 0; } to { rotate: 14deg; translate: 6px -6px; } }

  /* sparkles, twinkling */
  .spark { position: absolute; z-index: 1; width: 4%; pointer-events: none; animation: twinkle 3.2s ease-in-out infinite; }
  .spark path { fill: var(--lime); stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
  .s1 { left: 31%; top: 12%; animation-delay: -.4s; } .s2 { left: 63%; top: 4%; width: 3%; animation-delay: -1.4s; }
  .s3 { left: 93%; top: 40%; animation-delay: -2.2s; } .s4 { left: 3%; top: 47%; width: 3%; animation-delay: -.9s; }
  .s5 { left: 38%; top: 86%; animation-delay: -1.8s; } .s6 { left: 59%; top: 82%; width: 2.8%; animation-delay: -2.7s; }
  .s7 { left: 46%; top: 7%; width: 2.4%; animation-delay: -.2s; }
  @keyframes twinkle { 0%, 100% { scale: .7; opacity: .7; rotate: 0deg; } 50% { scale: 1.15; opacity: 1; rotate: 20deg; } }
  .board:has(.obj:hover, .obj:focus-visible) :is(.flower, .spark) { opacity: .3; }

  @media (max-width: 640px) {
    .board { aspect-ratio: 3 / 5.6; }
    .obj { left: var(--mx); top: var(--my); width: var(--mw); }
    .board-center { top: 17%; }
    .board-title { font-size: clamp(32px, 10vw, 44px); }
    .now { margin-top: 12px; font-size: 10px; }
    .f1 { left: 42%; top: 56%; width: 12%; } .f2 { left: 80%; top: 8%; width: 11%; } .f3 { left: 6%; top: 88%; width: 10%; }
    .spark { width: 7%; } .s1 { left: 8%; top: 6%; } .s2 { left: 70%; top: 3%; width: 4%; } .s3 { left: 90%; top: 30%; } .s4 { left: 4%; top: 58%; width: 4%; } .s5 { left: 40%; top: 92%; } .s6 { left: 88%; top: 90%; width: 4%; } .s7 { display: none; }
    .tag { font-size: 9.5px; padding: 5px 7px; letter-spacing: .06em; white-space: normal; width: max-content; max-width: 100%; text-align: center; }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/shared';

  // The table tilts gently towards the cursor: each object moves by its own depth.
  function initBoard() {
    const board = document.querySelector<HTMLElement>('[data-board]');
    board?.querySelectorAll('.obj').forEach((o) => o.addEventListener('pointerenter', () => board.classList.add('touched'), { once: true }));
    if (!board || reducedMotion() || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    let raf = 0, x = 0, y = 0;
    board.addEventListener('pointermove', (e) => {
      const r = board.getBoundingClientRect();
      x = ((e.clientX - r.left) / r.width) * 2 - 1;
      y = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; board.style.setProperty('--px', x.toFixed(3)); board.style.setProperty('--py', y.toFixed(3)); });
    });
    board.addEventListener('pointerleave', () => { board.style.setProperty('--px', '0'); board.style.setProperty('--py', '0'); });
  }
  document.addEventListener('astro:page-load', initBoard);
</script>
