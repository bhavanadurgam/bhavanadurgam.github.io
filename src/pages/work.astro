---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../layouts/Section.astro';
import { experience, impact } from '../data/content';

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.png', { eager: true });
const logo = (name: string) => logos[`../assets/logos/${name}.png`]?.default;
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<Section id="work" title="Work Experience — Bhavana Durgam" description="Bhavana Durgam, biomedical engineer turned Product Manager: 0→1 launch to $100K+ first-year revenue, AI voice product strategy for 250 dental clinics, 40% faster releases at Capgemini, and BCI research.">
  <header class="frame-head">
    <p class="kicker">File No.01</p>
    <h1 class="title">Where I've <em>built</em></h1>
    <p class="lede">Four-plus years building products across healthcare, consumer and enterprise: from customer discovery and PRDs to roadmaps, launches and the go-to-market that makes them land.</p>
  </header>

  <ul class="impact" aria-label="Impact at a glance">
    {impact.map((m, i) => (
      <li class="stat reveal" style={`--d: ${i * 80}ms`}>
        <span class="s-trait mono">{m.trait}</span>
        <span class="s-val">{m.value}</span>
        <span class="s-label">{m.label}</span>
      </li>
    ))}
  </ul>

  <ol class="timeline work-line" data-lit-line>
    {experience.map((j) => {
      const img = logo(j.logo);
      return (
        <li class="t-entry job" style={`--dc: var(${j.color})`}>
          <span class="t-logo">
            {img ? <Image src={img} alt={`${j.company} logo`} width={112} height={112} /> : null}
          </span>
          <p class="t-date">{j.dates} · {j.place}</p>
          <h2 class="t-role">{j.role}</h2>
          <p class="t-org">{j.company}</p>
          <ul class="tags">{j.tags.map((t) => <li class="pill">{t}</li>)}</ul>
          <ul class="t-list">{j.bullets.map((b) => <li class="line" set:html={bold(b)} />)}</ul>
        </li>
      );
    })}
  </ol>
</Section>

<style>
  /* ── Impact strip ─────────────────────────────── */
  .impact { list-style: none; padding: 0; margin: 0 0 clamp(48px, 6vw, 72px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .stat {
    display: grid; align-content: start; gap: 8px; padding: 22px 20px 20px; border-radius: 16px;
    background: var(--ivory); border: 1.5px solid var(--plum); box-shadow: 5px 5px 0 var(--rose);
  }
  .stat:nth-child(2) { box-shadow: 5px 5px 0 var(--lime); }
  .stat:nth-child(4) { box-shadow: 5px 5px 0 var(--lime); }
  .s-trait { font-size: 11px; font-weight: 700; color: var(--plum); }
  .s-val { font: 800 clamp(40px, 4.6vw, 58px)/.9 var(--display); letter-spacing: -0.04em; color: var(--ink); }
  .s-label { font-size: 14px; line-height: 1.4; color: var(--muted); }

  @media (max-width: 960px) { .impact { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
