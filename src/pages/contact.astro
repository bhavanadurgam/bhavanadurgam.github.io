---
import Section from '../layouts/Section.astro';
import { site } from '../data/content';
const circles = [
  { label: 'LinkedIn', sub: 'in/bhavanadurgam', href: site.socials.linkedin, c: '--rose-soft', r: -6, logo: 'linkedin' },
  { label: 'Instagram', sub: site.socials.instagramHandle, href: site.socials.instagram, c: '--lime', r: 5, logo: 'instagram' },
  { label: 'Email', sub: 'Write to me', href: `mailto:${site.email}`, c: '--rose', r: -4, logo: 'email' },
];
---
<Section id="contact" title="Contact — Bhavana Durgam" description="Contact Bhavana Durgam, Product Manager with product marketing experience in Chicago: LinkedIn, Instagram and email. Open to PM and PMM opportunities.">
  <header class="frame-head center">
    <p class="kicker">Contact</p>
    <h1 class="title">Let's <em>talk</em></h1>
    <p class="lede">Open to PM and PMM opportunities, collaborations, and good book recommendations.</p>
  </header>

  <ul class="circles">
    {circles.map((c) => (
      <li class="reveal">
        <a class="circle-link" href={c.href} target={c.label === 'Email' ? undefined : '_blank'} rel={c.label === 'Email' ? undefined : 'noopener me'} style={`--cc: var(${c.c}); --rr: ${c.r}deg`} data-sound>
          <span class="circle">
            {c.logo === 'linkedin' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="1" y="1" width="22" height="22" rx="4" fill="#0A66C2" />
                <g fill="#fff"><circle cx="6.6" cy="6.9" r="1.9" /><rect x="5" y="9.6" width="3.2" height="9.4" /><path d="M10.4 9.6h3.05v1.4h.05c.42-.8 1.47-1.65 3.03-1.65 3.24 0 3.84 2.13 3.84 4.9V19h-3.2v-4.2c0-1-.02-2.3-1.4-2.3-1.4 0-1.62 1.1-1.62 2.22V19h-3.2z" /></g>
              </svg>
            )}
            {c.logo === 'instagram' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <defs><radialGradient id="ig-grad" cx="0.3" cy="1.07" r="1.3"><stop offset="0" stop-color="#FFDD55" /><stop offset=".1" stop-color="#FFDD55" /><stop offset=".5" stop-color="#FF543E" /><stop offset="1" stop-color="#C837AB" /></radialGradient></defs>
                <rect x="1" y="1" width="22" height="22" rx="6.5" fill="url(#ig-grad)" />
                <g fill="none" stroke="#fff" stroke-width="1.8"><rect x="5.2" y="5.2" width="13.6" height="13.6" rx="4" /><circle cx="12" cy="12" r="3.3" /></g>
                <circle cx="16.3" cy="7.7" r="1.05" fill="#fff" />
              </svg>
            )}
            {c.logo === 'email' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="1.5" y="4.5" width="21" height="15" rx="2.5" fill="#6E1E3B" />
                <path d="M3 6.3 12 13l9-6.7" fill="none" stroke="#F7F6D7" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </span>
          <span class="c-label">{c.label}</span>
          <span class="c-sub mono">{c.sub}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="email-bar reveal">
    <span class="mono eb-k">Email</span>
    <a href={`mailto:${site.email}`} data-email-text>{site.email}</a>
    <button class="btn btn-ink" type="button" data-copy={site.email}>Copy</button>
  </div>
</Section>

<style>
  .center { text-align: center; display: grid; justify-items: center; }
  .circles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(24px, 5vw, 64px); margin: 12px 0 56px; }
  .circle-link { display: grid; justify-items: center; gap: 8px; text-decoration: none; }
  .circle {
    width: 150px; height: 150px; border-radius: 50%; display: grid; place-items: center; background: var(--cc);
    color: var(--ink); box-shadow: 0 6px 0 rgba(45,10,23,.18); transition: transform .45s var(--spring), box-shadow .45s var(--spring);
  }
  .circle svg { width: 62px; height: 62px; filter: drop-shadow(0 3px 4px rgba(45,10,23,.18)); }
  .circle-link:hover .circle, .circle-link:focus-visible .circle { transform: translateY(-10px) rotate(var(--rr)); box-shadow: 0 16px 0 rgba(45,10,23,.14); }
  .c-label { font: 400 28px/1 var(--serif); margin-top: 8px; }
  .c-sub { font-size: 11px; font-weight: 700; color: var(--muted); }
  .email-bar {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px 20px; max-width: 680px; margin: 0 auto;
    padding: 16px 16px 16px 24px; border: 1.5px dashed var(--line); border-radius: 14px; background: #fff;
  }
  .eb-k { font-size: 11px; font-weight: 700; color: var(--muted); }
  .email-bar a { font: 400 clamp(20px, 2.6vw, 28px)/1.2 var(--serif); text-decoration: none; user-select: all; word-break: break-all; }
  @media (max-width: 640px) { .circle { width: 112px; height: 112px; } .circle svg { width: 48px; height: 48px; } }
</style>
