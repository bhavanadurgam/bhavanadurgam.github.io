---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../layouts/Section.astro';
import { missIndia, modelling } from '../data/content';

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/{acc,press,videos}/**/*.jpg', { eager: true });
const img = (path: string) => all[`../assets/${path}.jpg`]?.default;
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
// Full-size version for the lightbox.
const full = async (m: ImageMetadata) => (await getImage({ src: m, width: Math.min(m.width, 1400), format: 'webp' })).src;

const photos = await Promise.all(missIndia.photos.map(async (p) => ({ ...p, m: img(`acc/missindia/${p.img}`)! , big: await full(img(`acc/missindia/${p.img}`)!) })));
const clips = await Promise.all(missIndia.clippings.map(async (c) => ({ ...c, m: img(`acc/clippings/${c.img}`)!, big: await full(img(`acc/clippings/${c.img}`)!) })));
const campaigns = await Promise.all(modelling.campaigns.map(async (c) => ({ ...c, m: img(`acc/modelling/${c.img}`)!, big: await full(img(`acc/modelling/${c.img}`)!) })));
const yt = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---
<Section id="accomplishments" title="Accomplishments — Bhavana Durgam" description="Bhavana Durgam: Femina Miss India Karnataka 2018, Top 10 at Femina Miss India, Miss Goodness Ambassador and Top 10 Beauty with a Purpose; model and actor since age six for Canon, Redmi, Bhima, Myntra, Ajio and more.">
  <header class="frame-head">
    <p class="kicker">File No.04</p>
    <h1 class="title">Crowns &amp; <em>cameras</em></h1>
    <p class="lede">Long before product, two things taught me how to read a room and tell a story: a year as Femina Miss India Karnataka spent on education and health in underserved communities, and a lifetime in front of the camera.</p>
    <nav class="jump" aria-label="On this page">
      <a class="pill" href="#miss-india">♛ Miss India</a>
      <a class="pill" href="#model-actor">✧ Model &amp; actor</a>
    </nav>
  </header>

  <!-- ═══ Miss India ═══ -->
  <section class="block" id="miss-india" aria-labelledby="mi-h">
    <p class="kicker">01 · The reign</p>
    <h2 class="h2" id="mi-h">Femina Miss India <em>Karnataka</em> 2018</h2>

    <ul class="titles">
      {missIndia.titles.map((t, i) => (
        <li class="crown reveal" style={`--d: ${i * 70}ms`}>
          <span class="c-ico" aria-hidden="true">♛</span>
          <span class="c-title">{t.title}</span>
          <span class="c-year mono">{t.year}</span>
          <span class="c-note">{t.note}</span>
        </li>
      ))}
    </ul>

    <div class="reign">
      <div>
        <h3 class="sub">The work behind the crown</h3>
        <ul class="t-list reign-lines" data-lit-line>
          <li class="job">
            <ul class="t-list">{missIndia.work.map((w) => <li class="line" set:html={bold(w)} />)}</ul>
          </li>
        </ul>
      </div>
      <ul class="stats">
        {missIndia.stats.map((s) => (
          <li class="stat reveal"><span class="s-val">{s.value}</span><span class="s-label">{s.label}</span></li>
        ))}
      </ul>
    </div>

    <ul class="strip" aria-label="Miss India photos">
      {photos.map((p, i) => (
        <li class="reveal" style={`--d: ${i * 60}ms; --r: ${[-3, 2, -1.5, 3, -2.5, 1.5][i % 6]}deg`}>
          <button class="polaroid shot" type="button" data-lightbox={p.big} data-caption={p.caption} aria-label={`Open photo: ${p.caption}`}>
            <span class="ph"><Image src={p.m} alt={`Bhavana Durgam: ${p.caption}`} widths={[260, 520]} sizes="220px" style={`object-position: ${p.pos}`} /></span>
            <span class="cap">{p.caption}</span>
          </button>
        </li>
      ))}
    </ul>

    <h3 class="sub">In the news</h3>
    <ul class="press">
      {missIndia.press.map((a) => {
        const m = img(a.img);
        return (
          <li class="reveal">
            <a class="article" href={a.url} target="_blank" rel="noopener">
              <span class="a-img">{m && <Image src={m} alt="" widths={[360, 640]} sizes="(max-width: 640px) 90vw, 340px" />}</span>
              <span class="a-meta mono">{a.outlet} · {a.date}</span>
              <span class="a-title">{a.title}</span>
              <span class="a-go mono">Read the article ↗</span>
            </a>
          </li>
        );
      })}
    </ul>

    <h3 class="sub">In print</h3>
    <p class="hint mono">Click a clipping to read it</p>
    <ul class="clips">
      {clips.map((c, i) => (
        <li class="reveal" style={`--d: ${i * 50}ms; --r: ${[-2, 1.5, -1, 2, -1.5, 1, -2.5, 2][i % 8]}deg`}>
          <button class="clip-card" type="button" data-lightbox={c.big} data-caption={`${c.outlet} · ${c.date} · ${c.title}`} aria-label={`Open clipping: ${c.title}`}>
            <span class="tape" aria-hidden="true"></span>
            <Image src={c.m} alt={`${c.outlet} clipping: ${c.title}`} widths={[320, 640]} sizes="260px" />
            <span class="cl-meta mono">{c.outlet} · {c.date}</span>
            <span class="cl-title">{c.title}</span>
          </button>
        </li>
      ))}
    </ul>

    <h3 class="sub">Watch</h3>
    <ul class="videos two">
      {missIndia.videos.map((v) => (
        <li class="reveal">
          <a class="video" href={yt(v.id)} target="_blank" rel="noopener">
            <span class="v-img"><Image src={img(`videos/${v.id}`)!} alt="" width={480} height={270} /><span class="play" aria-hidden="true">▶</span></span>
            <span class="v-title">{v.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ═══ Model & actor ═══ -->
  <section class="block" id="model-actor" aria-labelledby="ma-h">
    <p class="kicker">02 · In front of the camera</p>
    <h2 class="h2" id="ma-h">Model &amp; actor <em>since six</em></h2>

    <ul class="stats four">
      {modelling.stats.map((s) => (
        <li class="stat reveal"><span class="s-val">{s.value}</span><span class="s-label">{s.label}</span></li>
      ))}
    </ul>

    <div class="brands" aria-label="Brands I've worked with">
      <div class="brand-row"><span class="b-k mono">TV &amp; digital</span><ul>{modelling.commercials.map((b) => <li>{b}</li>)}</ul></div>
      <div class="brand-row"><span class="b-k mono">Print &amp; billboards</span><ul>{modelling.print.map((b) => <li>{b}</li>)}</ul></div>
      <div class="brand-row"><span class="b-k mono">Ramp</span><ul>{modelling.ramp.map((b) => <li>{b}</li>)}</ul></div>
      <div class="brand-row"><span class="b-k mono">Film</span><ul><li><em>{modelling.film.title}</em> · {modelling.film.note}</li></ul></div>
    </div>

    <h3 class="sub">Commercials</h3>
    <ul class="videos">
      {modelling.ads.map((v, i) => (
        <li class="reveal" style={`--d: ${(i % 3) * 60}ms`}>
          <a class="video" href={yt(v.id)} target="_blank" rel="noopener">
            <span class="v-img"><Image src={img(`videos/${v.id}`)!} alt="" width={480} height={270} /><span class="play" aria-hidden="true">▶</span></span>
            <span class="v-brand mono">{v.brand}</span>
            <span class="v-title">{v.title}</span>
          </a>
        </li>
      ))}
      {modelling.links.map((l) => (
        <li class="reveal">
          <a class="video link-card" href={l.url} target="_blank" rel="noopener">
            <span class="v-img lc"><span class="lc-brand">{l.brand}</span><span class="play" aria-hidden="true">↗</span></span>
            <span class="v-brand mono">{l.where}</span>
            <span class="v-title">{l.title}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="sub">Campaigns &amp; ramp</h3>
    <ul class="campaigns">
      {campaigns.map((c, i) => (
        <li class:list={['reveal', { tall: c.m.height > c.m.width }]} style={`--d: ${(i % 4) * 60}ms`}>
          <button class="camp" type="button" data-lightbox={c.big} data-caption={c.caption} aria-label={`Open photo: ${c.caption}`}>
            <Image src={c.m} alt={`Bhavana Durgam: ${c.caption}`} widths={[400, 800]} sizes="(max-width: 640px) 90vw, 380px" style={`object-position: ${c.pos}`} />
            <span class="camp-cap mono">{c.caption}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <div class="modal lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lb-cap">
    <div class="modal-card lb-card">
      <button class="modal-close" type="button" aria-label="Close">✕</button>
      <img class="lb-img" alt="" />
      <p class="lb-cap mono" id="lb-cap"></p>
    </div>
  </div>
</Section>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .jump .pill { text-decoration: none; background: var(--rose-soft); border-color: transparent; color: var(--plum); min-height: 34px; padding: 0 14px; }
  .jump .pill:hover { background: var(--lime); color: var(--ink); }
  .block { padding-top: 12px; scroll-margin-top: calc(var(--header) + 24px); }
  .block + .block { margin-top: clamp(56px, 8vw, 96px); padding-top: clamp(40px, 6vw, 64px); border-top: 1.5px dashed var(--line); }
  .block > .h2 { margin: 8px 0 28px; }
  .sub { font: 800 clamp(22px, 2.4vw, 28px)/1.1 var(--display); letter-spacing: -0.02em; margin: clamp(40px, 6vw, 64px) 0 18px; }
  .hint { font-size: 11px; font-weight: 700; color: var(--muted); margin: -10px 0 16px; }

  /* Titles */
  .titles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .crown {
    position: relative; display: grid; align-content: start; gap: 6px; padding: 20px 18px; border-radius: 16px;
    background: var(--plum); color: var(--ivory); box-shadow: 5px 5px 0 var(--rose); transition: transform .4s var(--spring);
  }
  .crown:nth-child(even) { background: var(--plum-deep); box-shadow: 5px 5px 0 var(--lime); }
  .crown:hover { transform: translateY(-6px) rotate(-1deg); }
  .c-ico { font-size: 26px; color: var(--lime); line-height: 1; }
  .c-title { font: 800 21px/1.1 var(--display); letter-spacing: -0.02em; }
  .c-year { font-size: 11px; font-weight: 700; color: var(--rose); }
  .c-note { font-size: 14px; line-height: 1.45; opacity: .85; }

  /* Reign work + stats */
  .reign { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .reign-lines { list-style: none; padding: 0; margin: 0; }
  .reign-lines .t-list { margin-top: 0; gap: 14px; }
  .stats { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .stats.four { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 28px; }
  .stat { display: grid; gap: 4px; padding: 18px; border-radius: 14px; background: var(--ivory); border: 1.5px solid var(--plum); box-shadow: 4px 4px 0 var(--rose); }
  .stat:nth-child(even) { box-shadow: 4px 4px 0 var(--lime); }
  .s-val { font: 800 clamp(34px, 3.6vw, 46px)/.9 var(--display); letter-spacing: -0.04em; }
  .s-label { font-size: 14px; line-height: 1.4; color: var(--muted); }

  /* Photo strip */
  .strip { list-style: none; padding: 26px 4px 8px; margin: 40px 0 0; display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--rose) transparent; }
  .strip li { flex: none; scroll-snap-align: start; }
  .shot { width: 210px; padding: 10px 10px 0; display: block; text-align: left; }
  .shot .ph { aspect-ratio: 4 / 5; }
  .shot .cap { display: block; padding: 10px 2px 12px; font: 700 12px/1.3 var(--mono); letter-spacing: .04em; color: var(--ink); }
  .shot:hover, .shot:focus-visible { transform: rotate(0) translateY(-10px) scale(1.04); z-index: 2; }

  /* Press cards */
  .press { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .article {
    display: grid; gap: 8px; height: 100%; padding: 10px 10px 16px; border-radius: 14px; text-decoration: none;
    background: #fff; border: 1.5px solid var(--line); transition: transform .4s var(--spring), box-shadow .4s, border-color .3s;
  }
  .article:hover, .article:focus-visible { transform: translateY(-6px); border-color: var(--plum); box-shadow: 6px 6px 0 var(--lime); }
  .a-img { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; background: var(--rose-soft); }
  .a-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; transition: transform .6s var(--smooth); }
  .article:hover .a-img :global(img) { transform: scale(1.05); }
  .a-meta { padding: 4px 6px 0; font-size: 11px; font-weight: 700; color: var(--plum); }
  .a-title { padding: 0 6px; font: 700 18px/1.3 var(--sans); color: var(--ink); }
  .a-go { margin-top: auto; padding: 0 6px; font-size: 11px; font-weight: 700; color: var(--muted); }
  .article:hover .a-go { color: var(--plum); }

  /* Clippings */
  .clips { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px 20px; }
  .clip-card {
    position: relative; display: grid; gap: 6px; width: 100%; padding: 10px 10px 14px; text-align: left;
    background: #FBF7E4; box-shadow: 0 12px 22px -14px rgba(45,10,23,.45); transform: rotate(var(--r));
    transition: transform .45s var(--spring), box-shadow .4s;
  }
  .clip-card:hover, .clip-card:focus-visible { transform: rotate(0) translateY(-8px) scale(1.03); box-shadow: 0 22px 30px -16px rgba(45,10,23,.5); z-index: 2; }
  .clip-card :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 20%; filter: sepia(.12); }
  .tape { position: absolute; top: -10px; left: 50%; width: 70px; height: 20px; transform: translateX(-50%) rotate(-3deg); background: color-mix(in srgb, var(--lime) 70%, transparent); }
  .cl-meta { font-size: 10.5px; font-weight: 700; color: var(--plum); }
  .cl-title { font: 600 15px/1.3 var(--sans); }

  /* Videos */
  .videos { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .videos.two { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 760px; }
  .video { display: grid; gap: 6px; text-decoration: none; }
  .v-img { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; border: 1.5px solid var(--plum); background: var(--plum-deep); }
  .v-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--smooth), filter .4s; }
  .play {
    position: absolute; left: 50%; top: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px; border-radius: 50%;
    display: grid; place-items: center; background: var(--lime); color: var(--ink); font-size: 18px; padding-left: 3px;
    box-shadow: 0 6px 16px rgba(0,0,0,.3); transition: transform .4s var(--spring);
  }
  .video:hover .v-img :global(img), .video:focus-visible .v-img :global(img) { transform: scale(1.06); filter: saturate(1.1); }
  .video:hover .play, .video:focus-visible .play { transform: scale(1.18); }
  .v-brand { margin-top: 4px; font-size: 11px; font-weight: 700; color: var(--plum); }
  .v-title { font: 600 15.5px/1.35 var(--sans); color: var(--ink); }
  .lc { display: grid; place-items: center; background: var(--rose); background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.18) 0 10px, transparent 10px 20px); }
  .link-card:nth-of-type(odd) .lc { background-color: var(--lime); }
  .lc-brand { font: 800 34px/1 var(--display); letter-spacing: -0.03em; color: var(--plum); }
  .lc .play { left: auto; right: 12px; top: auto; bottom: 12px; margin: 0; width: 40px; height: 40px; padding: 0; background: var(--plum); color: var(--ivory); }

  /* Brands */
  .brands { display: grid; gap: 14px; padding: 22px; border-radius: 16px; background: var(--plum-deep); color: var(--ivory); }
  .brand-row { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 14px; align-items: start; }
  .b-k { padding-top: 7px; font-size: 11px; font-weight: 700; color: var(--lime); }
  .brand-row ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .brand-row li { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(247,246,215,.3); font-size: 14px; transition: background .25s, color .25s, transform .3s var(--spring); }
  .brand-row li:hover { background: var(--rose); color: var(--ink); transform: translateY(-2px); }

  /* Campaigns */
  .campaigns { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 220px; grid-auto-flow: dense; gap: 14px; }
  .campaigns li { grid-column: span 2; }
  .campaigns li.tall { grid-column: span 1; grid-row: span 2; }
  .camp { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 14px; border: 1.5px solid var(--plum); }
  .camp :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--smooth); }
  .camp:hover :global(img), .camp:focus-visible :global(img) { transform: scale(1.06); }
  .camp-cap {
    position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 8px 10px; border-radius: 8px; text-align: left;
    background: color-mix(in srgb, var(--ivory) 92%, transparent); font-size: 11px; font-weight: 700; color: var(--ink);
    transform: translateY(6px); opacity: .92; transition: transform .35s var(--spring), opacity .3s;
  }
  .camp:hover .camp-cap { transform: none; opacity: 1; }

  /* Lightbox */
  .lb-card { display: grid; justify-items: center; gap: 12px; max-width: min(1000px, 100%); overflow: visible; }
  .lb-img { max-width: 100%; max-height: 80vh; width: auto; border-radius: 6px; background: var(--ivory); box-shadow: 0 30px 60px rgba(0,0,0,.4); }
  .lb-cap { color: var(--ivory); font-size: 12px; font-weight: 700; text-align: center; }
  .lightbox .modal-close { top: -14px; right: -14px; }

  @media (max-width: 960px) {
    .titles, .stats.four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reign { grid-template-columns: 1fr; }
    .stats:not(.four) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .press, .videos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .clips { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .campaigns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .titles, .press, .videos, .videos.two { grid-template-columns: 1fr; }
    .stats:not(.four) { grid-template-columns: 1fr; }
    .brand-row { grid-template-columns: 1fr; gap: 6px; }
    .campaigns { grid-auto-rows: 180px; }
    .campaigns li { grid-column: span 2; }
    .campaigns li.tall { grid-column: span 1; }
    .camp-cap { font-size: 10px; padding: 6px 8px; left: 6px; right: 6px; bottom: 6px; }
    .lightbox .modal-close { top: 6px; right: 6px; }
  }
</style>

<script>
  import { openModal } from '../scripts/shared';

  function initLightbox() {
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const pic = lb.querySelector<HTMLImageElement>('.lb-img')!;
    const cap = lb.querySelector<HTMLElement>('.lb-cap')!;
    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((b) => b.addEventListener('click', () => {
      pic.src = b.dataset.lightbox!;
      pic.alt = b.dataset.caption!;
      cap.textContent = b.dataset.caption!;
      openModal(lb);
    }));
  }
  document.addEventListener('astro:page-load', initLightbox);
</script>
